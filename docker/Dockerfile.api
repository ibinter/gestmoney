# ==============================================================================
# Dockerfile pour l'API NestJS - GESTMONEY
# Approche: installation + build dans un seul stage, runner minimaliste
# ==============================================================================

FROM node:20-alpine AS base
RUN npm install -g pnpm@9
WORKDIR /app

# ---- Stage Builder : install + build dans le même contexte ----
FROM base AS builder

COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc* ./
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/
COPY packages/database/package.json ./packages/database/

COPY turbo.json ./
COPY packages/ ./packages/
COPY apps/api/ ./apps/api/

# Installation avec shamefully-hoist pour éviter les symlinks pnpm cassés
RUN pnpm install --no-frozen-lockfile \
    --filter @gestmoney/api... \
    --filter @gestmoney/shared \
    --filter @gestmoney/database \
    --shamefully-hoist

# Générer le client Prisma
RUN pnpm --filter @gestmoney/database db:generate

# Build avec nest/webpack → dist/main.js bundlé (sans dépendances externes)
RUN cd apps/api && node_modules/.bin/nest build 2>&1; \
    test -f /app/apps/api/dist/main.js && echo "Nest build OK" || \
    (node_modules/.bin/tsc -p tsconfig.json --rootDir src --noEmitOnError false --skipLibCheck 2>&1 || true); \
    test -f /app/apps/api/dist/main.js && echo "Build OK" || echo "WARNING: dist/main.js not found"

# ---- Stage Runner : image minimale de production ----
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache openssl && \
    addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

# Copier le bundle compilé
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/dist ./apps/api/dist

# Copier les node_modules hoistés (plats, sans symlinks cassés)
COPY --from=builder --chown=nestjs:nodejs /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder --chown=nestjs:nodejs /app/node_modules ./node_modules

# Copier les packages partagés (Prisma client notamment)
COPY --from=builder --chown=nestjs:nodejs /app/packages ./packages

USER nestjs

EXPOSE 3010

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
  CMD wget --quiet --tries=1 --spider http://localhost:3010/api/v1/health || exit 1

CMD ["node", "apps/api/dist/main.js"]
